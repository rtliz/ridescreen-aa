<?xml version="1.0" encoding="utf-8"?>
<!-- Home redesign (mockups/app-redesign.html frames 1-2, bottom bar, More). System fonts only:
     sans-serif-condensed bold for numbers, sans-serif / sans-serif-medium for text. -->
<resources>
    <!-- Empty parent for the HomeRd.* styles below. -->
    <style name="HomeRd" />

    <!-- Quick tile (.tile): icon top-left, title + detail at the bottom. Content built in MainActivity.buildTile(). -->
    <style name="HomeRd.Tile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">96dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/bg_home_rd_card</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="HomeRd.Tile.Big">
        <item name="android:minHeight">112dp</item>
        <item name="android:paddingStart">12dp</item>
    </style>

    <!-- Today's numbers (.stat). -->
    <style name="HomeRd.StatBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_home_rd_stat</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="HomeRd.StatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="HomeRd.StatUnit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="HomeRd.StatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/home_rd_muted</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <!-- Section label (.lbl) on the More screen. -->
    <style name="HomeRd.SectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/home_rd_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Bottom bar labels (.tab): 12.5 px in the mockup. -->
    <style name="HomeRd.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- The thumb button (.cta .btn.p): amber Connect, red Stop (colour switched in MainActivity). -->
    <style name="Widget.HomeRd.Cta" parent="Widget.Material3.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/brand_orange</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="iconTint">@color/on_brand</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">10dp</item>
    </style>

    <!-- 48 dp outlined button (.btn.sm2): parking card actions. -->
    <style name="Widget.HomeRd.SmallButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/surface</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">18dp</item>
        <item name="iconPadding">8dp</item>
    </style>
</resources>
