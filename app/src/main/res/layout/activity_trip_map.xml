<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trip_map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/scr_back"
                style="@style/Scr.Back" />

            <TextView
                android:id="@+id/map_title"
                style="@style/Scr.BarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="@string/main_trip" />
        </LinearLayout>

        <TextView
            android:id="@+id/map_stats"
            style="@style/Scr.Sm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="" />

        <!-- Speed legend: slow (blue) to fast (red), same stops as the route colours. -->
        <View
            android:id="@+id/map_legend_bar"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_scr_speed_scale" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/map_video"
                style="@style/Scr.Btn.Small"
                android:layout_width="wrap_content"
                android:maxLines="1"
                android:text="@string/tv_button"
                android:visibility="gone"
                app:icon="@drawable/ic_scr_video" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/map_share"
                style="@style/Scr.Btn.Primary"
                android:layout_width="wrap_content"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:minHeight="48dp"
                android:text="@string/share_button"
                android:textSize="15sp"
                app:icon="@drawable/ic_scr_share" />
        </LinearLayout>
    </LinearLayout>

    <!-- "Everything I've ridden": routes / heat, and the period. Hidden for a single trip. -->
    <LinearLayout
        android:id="@+id/map_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_mode_routes"
            style="@style/Scr.Btn.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="13sp"
            android:text="@string/map_mode_routes" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_mode_heat"
            style="@style/Scr.Btn.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/map_mode_heat" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="6dp"
            android:background="@color/text_secondary"
            android:alpha="0.3" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_period_month"
            style="@style/Scr.Btn.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="13sp"
            android:text="@string/map_period_month" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_period_year"
            style="@style/Scr.Btn.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="13sp"
            android:text="@string/map_period_year" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/map_period_all"
            style="@style/Scr.Btn.Small"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingHorizontal="4dp"
            android:textSize="13sp"
            android:text="@string/map_period_all" />
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
