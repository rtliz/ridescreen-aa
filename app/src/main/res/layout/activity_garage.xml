<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/garage_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp">

        <ImageButton
            android:id="@+id/scr_back"
            style="@style/Scr.Back" />

        <TextView
            style="@style/Scr.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:text="@string/garage_garage" />
    </LinearLayout>

    <TextView
        style="@style/Scr.Sm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:text="@string/garage_each_bike_keeps_its_own_name_photo_screen_fit_re" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Empty state -->
            <TextView
                android:id="@+id/garage_empty"
                style="@style/Scr.Sm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:drawablePadding="12dp"
                android:drawableTop="@drawable/ic_scr_garage"
                android:drawableTint="@color/status_idle"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="24dp"
                android:text="@string/garage_no_bikes_yet_scan_your_dash_qr_or_enter_wi_fi_na"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/garage_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/garage_scan"
            style="@style/Scr.Btn.Primary"
            android:layout_width="match_parent"
            android:text="@string/garage_scan_new_bike"
            app:icon="@drawable/ic_qr" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/garage_manual"
            style="@style/Scr.Btn"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:text="@string/garage_enter_wi_fi_manually"
            app:icon="@drawable/ic_wifi" />
    </LinearLayout>
</LinearLayout>
